# The spike is a record of what compiles, not a build target — keep its output out.
spike/bin/
spike/obj/
spike/scene.svg

.fake
# Local package feed for running the notebooks before publication (docs/notebooks/README.md).
local-feed/

# The examples write their figures into the current directory, which is the repository root when
# you run them the obvious way (`dotnet fsi examples/wave-packet.fsx`). Those are artefacts of a
# run, not sources; the copies the README embeds are generated deliberately and live elsewhere.
/free-fall.svg
/wave-packet.svg
/wave-packet.tex

# Fable output (D130): the compiled JavaScript and the library Fable copies beside it.
tests/Marey.Fable/out/
fable_modules/
tests/Marey.Fable/out-packages/
examples/web/out/
fable-packages/

# tools/view/build.sh (step F, D157): the bundler it installs and the Fable output it bundles.
tools/view/node_modules/
tools/view/out/
