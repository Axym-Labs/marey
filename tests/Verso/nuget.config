<?xml version="1.0" encoding="utf-8"?>
<!-- Where `verso run`, started in this folder, finds the packages CI packed into artifacts/.
     A `#i` with a relative path does not resolve in a headless run, and the version the notebook
     asks for (0.0.0-ci) is on no other source. -->
<configuration>
  <packageSources>
    <add key="packed" value="../../artifacts" />
  </packageSources>
</configuration>
