<Project Sdk="Microsoft.NET.Sdk">

  <!-- D121's first consumer: a Fable app that compiles a figure in the browser and draws it on a
       canvas. Not in Marey.slnx and not packed: Fable builds it, and a static file server serves
       it. See README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="App.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Marey.Plot/Marey.Plot.fsproj" />
    <ProjectReference Include="../../src/Marey.Backend.Web/Marey.Backend.Web.fsproj" />
    <ProjectReference Include="../../src/Marey.Sim/Marey.Sim.fsproj" />
  </ItemGroup>

</Project>
