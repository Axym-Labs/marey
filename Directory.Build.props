<Project>

  <PropertyGroup>
    <!-- §1.3 / §12: the design is only true if it compiles clean. Warnings are errors
         everywhere, exactly as the spike does. FS0064 (measure over-constraint, §12.1)
         is a *warning* by default — this is what turns it into a build failure. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors></WarningsNotAsErrors>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>false</EnablePackageValidation>

    <!-- Unused-variable and implicit-obsolete warnings are off by default in F#. -->
    <OtherFlags>$(OtherFlags) --warnon:1182 --warnon:3390</OtherFlags>

    <Authors>Quiver contributors</Authors>
    <Product>Quiver</Product>
    <RepositoryUrl>https://github.com/Jonathan-Schaefer-git/quiver</RepositoryUrl>
  </PropertyGroup>

</Project>
