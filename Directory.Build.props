<Project>

  <PropertyGroup>
    <!-- The design is only true if it compiles clean. Warnings are errors
         everywhere. FS0064 (measure over-constraint)
         is a *warning* by default — this is what turns it into a build failure. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors></WarningsNotAsErrors>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>false</EnablePackageValidation>

    <!-- Unused-variable and implicit-obsolete warnings are off by default in F#. -->
    <OtherFlags>$(OtherFlags) --warnon:1182 --warnon:3390</OtherFlags>

    <Authors>Marey contributors</Authors>
    <Product>Marey</Product>
    <RepositoryUrl>https://github.com/Axym-Labs/marey</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://axym-labs.github.io/marey/</PackageProjectUrl>

    <!-- The gallery page for a package with no readme is a blank slab with a dependency list,
         which is most of what a first-time visitor ever sees. `NUGET.md` rather than the root
         README because nuget.org does not resolve relative links: every link in it is absolute,
         which is a constraint the repository README should not have to carry. Packed into each
         package by Directory.Build.targets, which runs late enough to see IsPackable. -->
    <PackageReadmeFile>NUGET.md</PackageReadmeFile>

    <!-- 128x128, packed into every package by Directory.Build.targets. `icon` rather than the
         deprecated `iconUrl`: the image travels inside the .nupkg, so the gallery entry does
         not depend on a URL outliving the release. -->
    <PackageIcon>icon.png</PackageIcon>

    <!-- MIT, decided deliberately: shorter than Apache-2.0, and what most of the F# ecosystem
         uses, so it composes with the packages a consumer already has. The trade accepted in
         exchange is that MIT carries no explicit patent grant. An SPDX expression rather than
         `PackageLicenseFile`, because it needs no file packed into every one of the
         packages and NuGet renders it as a link to the canonical text. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Symbols beside each package, and SourceLink in them, which the SDK supplies for a GitHub
         repository: a debugger steps into Marey's source at the commit the package was built
         from. `EmbedUntrackedSources` carries the files the build generates; a CI build maps the
         runner's paths away so the packages do not depend on where they were built. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- The compiler service `Marey.Witnesses` reads F# through, at the lowest version it compiles
       against, a lower bound under a host's own pin (Tambour's, the first host); the FSharp.Core
       that version pins exactly; and the analyzer SDK `Marey.Analyzers` and its tests are built
       on, which pins a later compiler service of its own. -->
  <PropertyGroup>
    <MareyCompilerService>43.12.202</MareyCompilerService>
    <MareyCompilerServiceFSharpCore>10.1.202</MareyCompilerServiceFSharpCore>
    <MareyAnalyzersSdk>0.41.0</MareyAnalyzersSdk>
  </PropertyGroup>

  <!-- A pack with `NoBuild` packs what was built, so it must not build project
       references either. The F# SDK hooks `PackageFSharpDesignTimeTools` into a package's content,
       which depends on `_GetFrameworkAssemblyReferences` and so on `ResolveReferences`; on SDK
       10.0.1xx that builds every referenced project, and each fails with NETSDK1085. Without
       building references, `ResolveReferences` asks them for their target paths instead. -->
  <PropertyGroup Condition="'$(NoBuild)' == 'true'">
    <BuildProjectReferences>false</BuildProjectReferences>
  </PropertyGroup>

</Project>
