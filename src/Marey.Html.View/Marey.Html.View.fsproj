<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Step F, D157: the script a notebook page draws a scene with. Compiled by Fable and bundled
         by esbuild into src/Marey.Html/view/marey-view.js (tools/view/build.sh), which is committed
         and embedded in Marey.Html; CI rebuilds it and fails on a difference. Not packed, and not
         in the solution: .NET has nothing to draw on, and a contributor's build needs no Node. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>Marey.Html.View</AssemblyName>
    <RootNamespace>Marey</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="View.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Marey.Core\Marey.Core.fsproj" />
    <ProjectReference Include="..\Marey.Backend.Web\Marey.Backend.Web.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="5.3.0" />
  </ItemGroup>

</Project>
