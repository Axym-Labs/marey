<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Interaction as a pure step. Typed controls, the applicative `interact { }` block that
         composes them into a figure, and the step a host drives with the reader's messages. It
         names no host: the widget document is
         `Marey.Html`'s, and the channel is `Marey.Verso`'s.

         netstandard2.1 and Fable-compatible, like Core. NOTHING may be added to
         <PackageReference>.

         `Marey.Anim` does not reference this project, and must not, which a test checks:
         interaction is a source of values, not a kind of animation. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- Packed with its sources under fable/, so a Fable app can reference the
         package (Directory.Build.targets). -->
    <MareyFable>true</MareyFable>
    <AssemblyName>Marey.Interact</AssemblyName>
    <RootNamespace>Marey</RootNamespace>
    <Description>Interaction for Marey: typed controls (a slider over kelvin hands the view kelvin, and labels itself in them), composed into a live figure by an applicative block, and stepped by a pure function a notebook host drives: controls, zoom, pan, a readout in the axes' units, and recordings that replay as films.</Description>
    <PackageTags>fsharp visualization plotting interactive widgets notebook units-of-measure</PackageTags>

    <!-- A package ships with a producer: here, the widget document `Html.widget` draws what
         this steps. -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Control.fs" />
    <Compile Include="Recording.fs" />
    <Compile Include="Live.fs" />
    <!-- The unit-required mode, after the implementations it reaches. -->
    <Compile Include="UnitsOfMeasure.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Marey.Core\Marey.Core.fsproj" />
    <ProjectReference Include="..\Marey.Units\Marey.Units.fsproj" />
    <ProjectReference Include="..\Marey.Plot\Marey.Plot.fsproj" />
  </ItemGroup>

</Project>
