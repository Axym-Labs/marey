<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Marey.Units</AssemblyName>
    <RootNamespace>Marey</RootNamespace>
    <Description>SI, derived and common non-SI unit witnesses; Dim-driven symbol canonicalisation, prefix selection, and Unicode/ASCII/LaTeX/siunitx rendering.</Description>
    <PackageTags>fsharp units-of-measure si-units dimensional-analysis physics siunitx unit-conversion scientific</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Si.fs" />
    <Compile Include="Derived.fs" />
    <Compile Include="NonSi.fs" />
    <Compile Include="Registry.fs" />
    <Compile Include="Prefix.fs" />
    <Compile Include="UnitDisplay.fs" />
    <Compile Include="Axis.fs" />
    <!-- D110 — U.parse, the UDUNITS-2 syntax. After every witness it can name. -->
    <Compile Include="Parse.fs" />
    <!-- D124 — the C# surface, `using Marey.CSharp`. Last: it names every witness above. -->
    <Compile Include="CSharp.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Marey.Core\Marey.Core.fsproj" />
  </ItemGroup>

</Project>
