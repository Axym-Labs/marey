<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- This began as a .NET Interactive formatter so a figure displays inline as SVG.

         **That host is dead.** Polyglot Notebooks was deprecated on 2026-02-11 and
         retired 2026-03-27; .NET Interactive, the engine under it, followed on 2026-04-24. The
         maintained successor is Verso, whose display pipeline is a different mechanism entirely
         (see `src/Marey.Verso/`). The registration half of this package — `Formatters.fs`, the
         packaged `extension.dib`, and the `Microsoft.DotNet.Interactive.Formatting` reference —
         was deleted rather than carried, because a dependency on a retired engine is not free:
         it is a prerelease reference in every `dotnet pack`, and a paragraph of documentation
         pointing readers at something they cannot install.

         What survives is the half that was never about the host. `Html.fs` is
         `something -> string` and knows nothing about kernels, which is exactly why it outlived
         the kernel it was written for. Verso reaches it through one bridge function.

         netstandard2.1: this assembly is loaded into somebody else's process, and the notebook
         host is whatever the reader installed. netstandard2.1 loads on every runtime from .NET
         Core 3.0 forward, and matches the rest of the repo.

         It sits at the top of the DAG and references Core, Units, Svg and Plot. That is
         allowed: the rule that a grammar package references no backend constrains `Marey.Plot`,
         not a leaf integration package.

         The *name* is now wrong — it names a retired Microsoft product — and is left alone:
         the package is published under it. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Marey.Html</AssemblyName>
    <RootNamespace>Marey</RootNamespace>
    <Description>HTML renderings of Marey values for notebooks: figures and scenes as inline SVG, colours as swatches, ramps resampled through Oklab, palettes, dimensions, unit witnesses and erased scales, and a live figure's page. Host-neutral and dependency-free.</Description>
    <PackageTags>fsharp html svg notebook plotting visualization formatter units-of-measure</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Html.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The script a canvas page draws a scene with, built from src/Marey.Html.View by
         tools/view/build.sh and committed. CI rebuilds it and fails on a difference. -->
    <EmbeddedResource Include="view/marey-view.js" LogicalName="marey-view.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Marey.Core\Marey.Core.fsproj" />
    <ProjectReference Include="..\Marey.Units\Marey.Units.fsproj" />
    <ProjectReference Include="..\Marey.Backend.Svg\Marey.Backend.Svg.fsproj" />
    <ProjectReference Include="..\Marey.Plot\Marey.Plot.fsproj" />
    <ProjectReference Include="..\Marey.Interact\Marey.Interact.fsproj" />
  </ItemGroup>

</Project>
