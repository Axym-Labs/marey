<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- §6's GPU row, as D115 took it: Skia's GPU backend draws everything Skia draws, on an
         OpenGL 3.3 core context, and the nodes Skia draws badly (§0.3 of the M5 inventory) are
         claimed through `SkiaPainter` and drawn here. Not Fable-compatible and does not claim
         to be: a GL context has no meaning in a notebook kernel's browser half.

         net8.0 rather than netstandard2.1, for `NativeLibrary`: the package's own GLFW has to be
         loaded by .NET's native-asset resolution before Silk.NET looks for it by name (see
         `GlfwLibrary`). A GPU renderer has no consumer on a runtime older than that. -->
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Marey.Backend.Gpu</AssemblyName>
    <RootNamespace>Marey</RootNamespace>
    <Description>GPU rendering for Marey: Skia on OpenGL, with batched marks drawn by the GPU directly. A figure, a film's frames or a million points, offscreen; fluid solvers and LIC on the GPU.</Description>
    <PackageTags>fsharp opengl gpu skia plotting charts rendering visualization</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="GpuMarkers.fs" />
    <Compile Include="GpuCompute.fs" />
    <Compile Include="GpuContext.fs" />
    <Compile Include="GpuLic.fs" />
    <Compile Include="GpuRenderer.fs" />
    <Compile Include="GpuSim.fs" />
    <Compile Include="WindowInput.fs" />
    <Compile Include="GpuWindow.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Marey.Core\Marey.Core.fsproj" />
    <ProjectReference Include="..\Marey.Backend.Skia\Marey.Backend.Skia.fsproj" />
    <!-- The window (D118) shows a `Figure` or a live value and steps it with `Live.step`. -->
    <ProjectReference Include="..\Marey.Interact\Marey.Interact.fsproj" />
    <!-- D151: the GPU solvers step `Marey.Sim`'s states, and share this package's context and
         thread (D117), so they live here rather than in a package of their own. -->
    <ProjectReference Include="..\Marey.Sim\Marey.Sim.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- GLFW only. `Silk.NET.Windowing` is a meta-package that brings SDL as well, a second
         native windowing library this package would never load. Pinned for D33's reason: a
         windowing layer that moves under a pinned rasteriser is a bug report nobody can
         reproduce. -->
    <PackageReference Include="Silk.NET.Windowing.Glfw" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
  </ItemGroup>

</Project>
