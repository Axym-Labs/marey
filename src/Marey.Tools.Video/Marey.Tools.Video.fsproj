<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1 to match every other library here. Like `Marey.Toolchain`, and for the
         same reason, this one is *not* Fable-compatible and does not claim to be: a `Process`
         has no browser meaning. `Marey.Plot`'s Fable floor is untouched because the dependency
         points this way and not back. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Marey.Tools.Video</AssemblyName>
    <RootNamespace>Marey</RootNamespace>
    <Description>Encode a rendered frame sequence to video by shelling out to ffmpeg. Degrades to the numbered frames when ffmpeg is absent.</Description>
    <PackageTags>fsharp visualization plotting animation video ffmpeg mp4 encoding</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Video.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- `Marey.Plot`, because `FrameSequence` is what this encodes and it lives there.
         That drags the whole plotting stack, and it costs nothing: a `FrameSequence` cannot
         exist without having been produced by `Frames.write`, so every possible consumer of
         this package already has the reference. Taking the sequence's *fields* instead — a
         directory, a pattern, a rate — would have avoided the edge and reintroduced D72's
         hazard, a second statement of a decided fact with nothing able to notice a
         disagreement; `FrameSequence.Stale` in particular is a warning only this package is in
         a position to act on.

         NOTHING may be added to <PackageReference> here. The point of D75's shell-out is that
         ffmpeg's licence stays ffmpeg's problem, and a managed wrapper would put the audit back
         on every consumer — which is exactly what the decision refused. -->
    <ProjectReference Include="..\Marey.Plot\Marey.Plot.fsproj" />
    <ProjectReference Include="..\Marey.Toolchain\Marey.Toolchain.fsproj" />
  </ItemGroup>

</Project>
