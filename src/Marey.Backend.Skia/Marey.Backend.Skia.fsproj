<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- §6's Skia row, and §14's M2.5 line: "PNG and PDF without a TeX installation, and the
         first backend that can measure text properly."

         `netstandard2.1` is **measured, not assumed** — the plan required that. SkiaSharp
         4.151.1 ships a `netstandard2.1` assembly, so this backend targets the same framework
         as every other one in the solution and nothing about the packaging story changes.

         This is the ONLY project in the solution with a third-party PackageReference, and that
         is the whole reason M2's plan split it out of the grammar release. §13 makes
         `Marey.Core` having zero dependencies non-negotiable; nothing here weakens that, because
         the reference points the other way — Skia depends on Core, never the reverse. A build
         gate asserts it rather than trusting it. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Marey.Backend.Skia</AssemblyName>
    <RootNamespace>Marey</RootNamespace>
    <Description>PNG and PDF output through SkiaSharp, with real text shaping via HarfBuzz. The first Marey backend that measures text rather than estimating it.</Description>
    <PackageTags>fsharp skia png pdf plotting charts rendering rasterization visualization harfbuzz</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- The measurer before the backend: `SkiaBackend` holds a `SkiaTextMeasurer` and draws
         with the `SKFont` and `SKShaper` it measured against, so the two cannot disagree. -->
    <Compile Include="SkiaText.fs" />
    <Compile Include="SkiaBackend.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Marey.Core\Marey.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned rather than floated. A rasteriser's output moves between versions for reasons
         that have nothing to do with this library, and §5 of the M2.5 plan accepts that by
         refusing to commit a PNG baseline — but a pinned version is still what makes a bug
         report reproducible.

         SkiaSharp pulls the Win32 and macOS native assets in as its own dependencies; Linux is
         not among them and has to be asked for by name, which is exactly the omission that
         turns into a `DllNotFoundException` on somebody's CI three frames down. -->
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.1" />
    <!-- HarfBuzz is a *second* native library with a *second* set of asset packages and its
         own version line — `SkiaSharp.HarfBuzz` 4.151.1 pulls `HarfBuzzSharp` 14.2.1.1, which
         carries Win32 and macOS assets and, again, not Linux. Measured with
         `dotnet list package` with transitives shown rather than assumed, because this is the
         same omission twice and the second one is the one nobody checks for. -->
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.1.1" />
  </ItemGroup>

</Project>
