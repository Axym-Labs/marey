<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1 to match every other library here, though this one is *not*
         Fable-compatible and does not claim to be: a PATH walk and a `Process` have no browser
         meaning. That is precisely why it is a separate project rather than a file in
         `Marey.Core`, whose §13 Fable promise is load-bearing and actively defended.

         NOTHING may be added to <PackageReference> in this file. It takes no dependency so that
         nothing referencing it acquires a transitive one — the same rule Core follows, kept here
         for a different reason: the packages that will consume this (D75's video tools, D79's TeX
         typesetting) already drag a toolchain each, and the probe that reports their absence must
         not be a third thing to install. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Marey.Toolchain</AssemblyName>
    <RootNamespace>Marey</RootNamespace>
    <Description>Resolution and invocation of the external programs Marey drives but does not ship. Zero dependencies.</Description>
    <PackageTags>fsharp visualization plotting process toolchain</PackageTags>

    <!-- Published because published packages depend on it: `Marey.Tools.Video` resolves
         `ffmpeg` through this module and `Marey.Tools.Tex` a TeX engine, and a published package
         may not depend on an unpublished one. -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Toolchain.fs" />
  </ItemGroup>

</Project>
