<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- "Build this first and treat it as the spec." Reference implementation and golden
         -image test oracle. Zero dependencies, so it works under Fable and in notebooks. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- Packed with its sources under fable/, so a Fable app can reference the
         package (Directory.Build.targets). -->
    <MareyFable>true</MareyFable>
    <AssemblyName>Marey.Backend.Svg</AssemblyName>
    <RootNamespace>Marey</RootNamespace>
    <Description>SVG output for Marey: the reference backend, in pure F# with no dependencies, deterministic to the byte, and the oracle Marey's golden tests compare against.</Description>
    <PackageTags>fsharp svg plotting charts rendering vector-graphics visualization deterministic</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="SvgWriter.fs" />
    <Compile Include="SvgBackend.fs" />
    <!-- The C# surface, `using Marey.CSharp`. -->
    <Compile Include="CSharp.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Marey.Core\Marey.Core.fsproj" />
  </ItemGroup>

</Project>
