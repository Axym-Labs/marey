<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A simulation is a step function, and everything else is already an `Anim`. The
         integrators are typed in three tiers: a second-order state with one unit for its
         coordinates, a 2-D first-order flow with time, and any state given a `Tangent`. None of
         them is erased: a `float[]` integrator checks nothing and was the slowest of the four
         shapes measured.

         → Core, Anim, and Fields for the grids the solvers step (which brings Plot).
         netstandard2.1 and Fable-compatible: the ODE half is arithmetic, so it runs in a browser
         page from the same source. A chaotic trajectory there is a different trajectory after
         tens of seconds, because Node's `sin` and `exp` differ from .NET's in the last bit; the
         documents say so. Nothing .NET-only goes in a claimed source file. NOTHING may be added
         to <PackageReference>. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <MareyFable>true</MareyFable>
    <AssemblyName>Marey.Sim</AssemblyName>
    <RootNamespace>Marey</RootNamespace>
    <Description>Simulation for Marey: ODE integrators typed by units of measure (Euler, RK4, Dormand-Prince, velocity Verlet, leapfrog), trajectories that seek like any other animation, invariants, events and collisions, Poincare sections, pathlines and particles, finite-difference heat, wave and Poisson solvers, and fluids by stable fluids and lattice Boltzmann.</Description>
    <PackageTags>fsharp simulation ode integrator runge-kutta verlet symplectic fluid lattice-boltzmann units-of-measure scientific</PackageTags>
    <!-- Its producer is the integrators: a step is usable alone, folded by hand or by
         `Sim.run`. -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Ode.fs" />
    <Compile Include="Events.fs" />
    <Compile Include="Sim.fs" />
    <Compile Include="Collide.fs" />
    <Compile Include="Poincare.fs" />
    <Compile Include="Unsteady.fs" />
    <Compile Include="Fdm.fs" />
    <Compile Include="Fluid.fs" />
    <Compile Include="Lattice.fs" />
    <!-- The unit-required mode, after the implementations it reaches. -->
    <Compile Include="UnitsOfMeasure.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Marey.Core\Marey.Core.fsproj" />
    <ProjectReference Include="..\Marey.Anim\Marey.Anim.fsproj" />
    <ProjectReference Include="..\Marey.Fields\Marey.Fields.fsproj" />
  </ItemGroup>

</Project>
