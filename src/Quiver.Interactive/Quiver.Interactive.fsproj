<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- §6: "a ~200-line package registering a .NET Interactive formatter so `figure` displays
         inline as SVG. Do it at M1; it is how people will first meet the library."

         netstandard2.1, **not** net10.0 as the M1 plan assumed. Two corrections:

           * the plan's reason for net10.0 was that `Microsoft.DotNet.Interactive.Formatting`
             "requires a modern TFM". It does not — the package ships `lib/netstandard2.0` and
             nothing else.
           * and the TFM here is not really ours to pick. This assembly is loaded *into
             somebody else's process*: the notebook kernel. A net10.0 assembly cannot be loaded
             by a `dotnet-interactive` running on net8.0 or net9.0, and the installed kernel is
             whatever the reader happened to `dotnet tool install` last year. netstandard2.1
             loads on every kernel from .NET Core 3.0 forward, and matches the rest of the repo.

         It sits at the top of the DAG and references Core, Units, Svg and Plot. That does not
         violate D21, which constrains `Quiver.Plot`, not a leaf integration package. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Quiver.Interactive</AssemblyName>
    <RootNamespace>Quiver</RootNamespace>
    <Description>.NET Interactive integration. Figures, scenes, colours, ramps, units and scales display inline in a notebook; `#r "nuget: Quiver.Interactive"` is the whole setup.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Html.fs" />
    <Compile Include="Formatters.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Quiver.Core\Quiver.Core.fsproj" />
    <ProjectReference Include="..\Quiver.Units\Quiver.Units.fsproj" />
    <ProjectReference Include="..\Quiver.Backend.Svg\Quiver.Backend.Svg.fsproj" />
    <ProjectReference Include="..\Quiver.Plot\Quiver.Plot.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- **Compile against it; do not ship it.** `PrivateAssets="all"` keeps
         `Microsoft.DotNet.Interactive.Formatting` out of the produced nuspec and out of the
         package's `lib`, which is right for three separate reasons:

           1. .NET Interactive has never published a stable version — only `1.0.0-beta.*`. A
              stable package with a prerelease dependency earns NU5104, and this repo builds
              with `TreatWarningsAsErrors`, so declaring the dependency would make `dotnet pack`
              fail. Suppressing that warning would be treating the symptom.
           2. The kernel has already loaded its own copy before our code runs. Shipping a second
              copy invites the classic notebook failure where `Formatter.Register` writes into a
              *different* assembly's static registry than the one the kernel reads from, and
              nothing displays, with no error anywhere.
           3. Every build of this package carries `AssemblyVersion 1.0.0.0` — the .NET
              Interactive convention — so a reference compiled against any beta is satisfied by
              the kernel's copy of any other beta. That is what makes (2) safe rather than
              merely convenient.

         The cost, stated plainly: `Formatters.register()` throws `FileNotFoundException` in a
         process that has no kernel. `Html.*` does not — nothing in it touches a Formatting
         type, and the CLR loads an assembly on first use of a member that needs it, not on
         assembly load. So the HTML functions are usable from an ordinary program and only the
         registration entry point is notebook-only. -->
    <PackageReference Include="Microsoft.DotNet.Interactive.Formatting" Version="1.0.0-beta.26120.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The auto-registration hook. A `.dib` at exactly this path is what the kernel looks for
         after `#r "nuget: ..."` resolves a package; the path is the contract, so it is spelled
         out here rather than globbed. -->
    <None Include="interactive-extensions\dotnet\extension.dib" Pack="true" PackagePath="interactive-extensions\dotnet\" />
  </ItemGroup>

</Project>
