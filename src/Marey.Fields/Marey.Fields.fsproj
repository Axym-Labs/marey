<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Fields as functions with a dimensioned domain and codomain, sampled onto grids, with
         the derived quantities whose units the type system works out. The geoms that draw them
         live in `Marey.Plot`, which is why this references it.

         netstandard2.1 and Fable-compatible, like Core: no `System.Math` call Fable lacks, no
         `Array.BinarySearch`, no reflection. NOTHING may be added to <PackageReference>. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- Packed with its sources under fable/, so a Fable app can reference the
         package (Directory.Build.targets). -->
    <MareyFable>true</MareyFable>
    <AssemblyName>Marey.Fields</AssemblyName>
    <RootNamespace>Marey</RootNamespace>
    <Description>Fields for Marey: scalar and vector fields on dimensioned planes, sampled onto grids, with gradient, divergence, curl and the Jacobian in the units the types work out. A phase space with a different unit on each axis is a first-class domain.</Description>
    <PackageTags>fsharp visualization plotting fields vector-field streamlines contour units-of-measure scientific</PackageTags>

    <!-- A package ships with a producer: here, the field geoms that draw what this samples. -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Grid.fs" />
    <Compile Include="Field.fs" />
    <Compile Include="Phase.fs" />
    <!-- The unit-required mode, after the implementations it reaches. -->
    <Compile Include="UnitsOfMeasure.fs" />
    <!-- The C# surface, `using Marey.CSharp`. -->
    <Compile Include="CSharp.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Marey.Core\Marey.Core.fsproj" />
    <ProjectReference Include="..\Marey.Plot\Marey.Plot.fsproj" />
  </ItemGroup>

</Project>
