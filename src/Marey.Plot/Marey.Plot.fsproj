<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- §13 calls this Marey.Grammar. It is Marey.Plot at M0 because the M0 scope is the
         matplotlib-shaped front door plus the axis/legend/layout compiler, not the full
         grammar-of-graphics CE (§9), which is M2. Renaming later is cheap; shipping a
         half-grammar under the grammar name is not. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Marey.Plot</AssemblyName>
    <RootNamespace>Marey</RootNamespace>
    <Description>Themes, palettes, constraint layout, and the axis/legend compiler that turns figures into Scene IR.</Description>
    <PackageTags>fsharp plotting charts visualization themes color-blind palettes layout scientific units-of-measure</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Keys.fs" />
    <Compile Include="Palette.fs" />
    <Compile Include="Theme.fs" />
    <Compile Include="Layout.fs" />
    <Compile Include="Axes.fs" />
    <Compile Include="Legend.fs" />
    <Compile Include="Geom.fs" />
    <Compile Include="Channel.fs" />
    <Compile Include="Colorbar.fs" />
    <Compile Include="Figure.fs" />
    <Compile Include="Levels.fs" />
    <Compile Include="Chart.fs" />
    <Compile Include="Plot.fs" />
    <Compile Include="Storyboard.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Marey.Core\Marey.Core.fsproj" />
    <ProjectReference Include="..\Marey.Units\Marey.Units.fsproj" />
    <!-- D69 — the storyboard CE names `Anim` and `Figure` in one signature, and there is no
         third place for it to stand. D72 refused this edge for `arrangeUnion` and was right to:
         a `float -> Figure` sampler made the dependency unnecessary there. It is necessary here,
         and the direction is chosen by weight. Marey.Anim is 36 KB with zero dependencies, so a
         static-only consumer of this package carries 10% more assembly and no new package
         reference; the other direction would put 345 KB of plotting, plus Marey.Units, behind
         `Anim.tween` for someone easing a colour. -->
    <ProjectReference Include="..\Marey.Anim\Marey.Anim.fsproj" />
  </ItemGroup>

</Project>
