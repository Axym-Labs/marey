<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- "Marey.Core having zero dependencies is non-negotiable: it is what lets the
         same IR run in a notebook, in a browser via Fable, and in an AOT-compiled native
         binary." netstandard2.1 is the Fable-compatible floor.

         NOTHING may be added to <ItemGroup><PackageReference> in this file. Ever.
         FSharp.Core is the language runtime, not a dependency. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- Packed with its sources under fable/, so a Fable app can reference the
         package (Directory.Build.targets). -->
    <MareyFable>true</MareyFable>
    <AssemblyName>Marey.Core</AssemblyName>
    <RootNamespace>Marey</RootNamespace>
    <Description>The core of Marey: SI dimension vectors and unit witnesses, values that carry their unit, unit-indexed geometry, scales, typed statistics, and the closed scene IR every backend draws. No dependencies.</Description>
    <PackageTags>fsharp visualization plotting units-of-measure dimensional-analysis scene-graph charting scientific statistics</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile order is the layer order. Each file may use only those above it. -->
    <Compile Include="Num.fs" />
    <Compile Include="Random.fs" />
    <Compile Include="Tex.fs" />
    <Compile Include="Space.fs" />
    <Compile Include="Dim.fs" />
    <Compile Include="Witness.fs" />
    <Compile Include="Quantity.fs" />
    <Compile Include="Color.fs" />
    <Compile Include="Vec.fs" />
    <Compile Include="Affine.fs" />
    <Compile Include="Interp.fs" />
    <Compile Include="Ticks.fs" />
    <Compile Include="Scale.fs" />
    <Compile Include="Erased.fs" />
    <Compile Include="Stat.fs" />
    <Compile Include="Scene.fs" />
    <!-- After Scene.fs: `Png.dataUri` takes an `Image`. In Core because the SVG
         and TikZ backends both use it. -->
    <Compile Include="Png.fs" />
    <Compile Include="Coord.fs" />
    <Compile Include="Backend.fs" />
    <!-- A scene as bytes, for a page that draws what a kernel compiled. After Backend.fs,
         because the text metrics it carries are an `ITextMeasurer`'s. -->
    <Compile Include="Wire.fs" />
  </ItemGroup>

</Project>
